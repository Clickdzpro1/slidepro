# Dockerfile.vercel — test DB connection from Vercel container to Neon
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn asyncpg

COPY <<'EOF' /app/main.py
import os
import ssl
from fastapi import FastAPI

app = FastAPI()

@app.get("/")
def root():
    db_url = os.getenv("DATABASE_URL", "NOT SET")
    return {
        "status": "ok",
        "service": "slidepro-api-db-test",
        "db_url_prefix": db_url[:30] + "..." if db_url else "NOT SET",
        "port": os.getenv("PORT", "NOT SET"),
    }

@app.get("/test-db")
async def test_db():
    import asyncpg
    db_url = os.getenv("DATABASE_URL", "")
    try:
        from urllib.parse import urlsplit
        split = urlsplit(db_url.replace("postgresql://", "postgres://"))
        ctx = ssl.create_default_context()
        conn = await asyncpg.connect(
            host=split.hostname,
            port=split.port or 5432,
            user=split.username,
            password=split.password,
            database=split.path.lstrip("/"),
            ssl=ctx,
            timeout=10,
        )
        version = await conn.fetchval("SELECT version()")
        await conn.close()
        return {"status": "connected", "version": version[:100]}
    except Exception as e:
        return {"status": "failed", "error": str(e)[:300]}
EOF

EXPOSE 80
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-80}"]
