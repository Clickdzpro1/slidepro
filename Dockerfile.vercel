# Dockerfile.vercel — FastAPI-only backend for Vercel Services (slim)
# Vercel container functions expect the server to listen on port 80.

# syntax=docker/dockerfile:1.7
FROM python:3.11-slim-trixie AS builder

WORKDIR /app/servers/fastapi

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN python -m venv --without-pip /opt/venv \
    && pip install --no-cache-dir uv

COPY servers/fastapi/pyproject.toml servers/fastapi/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-emit-project -o /tmp/requirements.txt \
    && uv pip install --python /opt/venv/bin/python -r /tmp/requirements.txt

COPY servers/fastapi /app/servers/fastapi
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python --no-deps .

# ---- Runtime ----
FROM python:3.11-slim-trixie AS runtime

WORKDIR /app/servers/fastapi

ENV PATH="/opt/venv/bin:${PATH}" \
    NODE_ENV=production \
    START_OLLAMA=false \
    APP_DATA_DIRECTORY=/tmp/app_data \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/servers/fastapi /app/servers/fastapi
COPY templates /app/templates

RUN mkdir -p /tmp/app_data/exports /tmp/app_data/images /tmp/app_data/uploads \
    /tmp/app_data/fonts /tmp/app_data/templates /tmp/app_data/pptx-to-html \
    /tmp/app_data/pptx-to-json && chmod -R a+rX /tmp/app_data

# Hardcode port 80 (Vercel container functions expect port 80).
# server.py binds to 0.0.0.0 when PORT env is set; we set it in the CMD.
ENV PORT=80
EXPOSE 80
CMD ["python", "server.py", "--port", "80", "--reload", "false", "--log-level", "info"]
