# Dockerfile.vercel — minimal test to verify Vercel container functions work
FROM python:3.11-slim

WORKDIR /app

# Create a minimal FastAPI app
RUN pip install --no-cache-dir fastapi uvicorn

COPY <<'EOF' /app/main.py
from fastapi import FastAPI
app = FastAPI()

@app.get("/")
def root():
    return {"status": "ok", "service": "slidepro-api"}

@app.get("/api/v1/auth/status")
def auth_status():
    return {"configured": True, "authenticated": False, "username": None, "user_id": None, "role": None}
EOF

EXPOSE 80
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-80}"]
